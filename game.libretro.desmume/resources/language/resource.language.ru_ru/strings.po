msgctxt "Addon Summary"
msgid "Nintendo - DS (DeSmuME)"
msgstr "Nintendo — DS (DeSmuME)"

msgctxt "Addon Description"
msgid "DeSmuME is software that allows you to emulate a Nintendo DS system."
msgstr "DeSmuME — это программное обеспечение, позволяющее эмулировать систему Nintendo DS."

msgctxt "Addon Disclaimer"
msgid "Special thanks to yopyop (original author of DeSmuME) and Martin Korth (author of GBATEK)"
msgstr "Особая благодарность yopyop (оригинальному автору DeSmuME) и Мартину Корту (автору GBATEK)"

msgctxt "#30001"
msgid "Firmware Language"
msgstr "Язык прошивки"

msgctxt "#30002"
msgid "Use External BIOS/Firmware (restart)"
msgstr "Использовать внешний BIOS/прошивку (перезапуск)"

msgctxt "#30003"
msgid "Boot Into BIOS (interpreter and external bios only)"
msgstr "Загружаться в BIOS (только интерпретатор и внешний BIOS)"

msgctxt "#30004"
msgid "Load Game Into Memory (restart)"
msgstr "Загружать игру в память (перезапуск)"

msgctxt "#30005"
msgid "CPU Cores"
msgstr "Ядра ЦП"

msgctxt "#30006"
msgid "CPU Mode (restart)"
msgstr "Режим ЦП (перезапуск)"

msgctxt "#30007"
msgid "JIT Block Size"
msgstr "Размер блока JIT"

msgctxt "#30008"
msgid "Enable Advanced Bus-Level Timing"
msgstr "Включить расширенную синхронизацию на уровне шины"

msgctxt "#30009"
msgid "Frameskip"
msgstr "Пропуск кадров"

msgctxt "#30010"
msgid "Internal Resolution"
msgstr "Внутреннее разрешение"

msgctxt "#30011"
msgid "OpenGL Rasterizer (restart)"
msgstr "Растеризатор OpenGL (перезапуск)"

msgctxt "#30012"
msgid "OpenGL: Color Depth (restart)"
msgstr "OpenGL: Глубина цвета (перезапуск)"

msgctxt "#30013"
msgid "OpenGL: Multisampling AA"
msgstr "OpenGL: Мультисэмплинг AA"

msgctxt "#30014"
msgid "OpenGL: Texture Smoothing"
msgstr "OpenGL: Сглаживание текстур"

msgctxt "#30015"
msgid "OpenGL: Shadow Polygons"
msgstr "OpenGL: Полигоны теней"

msgctxt "#30016"
msgid "OpenGL: Special 0 Alpha"
msgstr "OpenGL: Специальная альфа 0"

msgctxt "#30017"
msgid "OpenGL: NDS Depth Calculation"
msgstr "OpenGL: Расчёт глубины NDS"

msgctxt "#30018"
msgid "OpenGL: Depth-LEqual Polygon Facing"
msgstr "OpenGL: Ориентация полигонов Depth-LEqual"

msgctxt "#30019"
msgid "Soft3D: High-res Color Interpolation"
msgstr "Soft3D: Высококачественная цветовая интерполяция"

msgctxt "#30020"
msgid "Soft3D: Line Hack"
msgstr "Soft3D: Хак линий"

msgctxt "#30021"
msgid "Soft3D: Texture Hack"
msgstr "Soft3D: Хак текстур"

msgctxt "#30022"
msgid "Edge Marking"
msgstr "Выделение границ"

msgctxt "#30023"
msgid "Texture Scaling (xBrz)"
msgstr "Масштабирование текстур (xBrz)"

msgctxt "#30024"
msgid "Texture Deposterization"
msgstr "Депостеризация текстур"

msgctxt "#30025"
msgid "Screen Layout"
msgstr "Компоновка экрана"

msgctxt "#30026"
msgid "Screen Gap"
msgstr "Зазор между экранами"

msgctxt "#30027"
msgid "Hybrid Layout: Ratio"
msgstr "Гибридная компоновка: Соотношение"

msgctxt "#30028"
msgid "Hybrid Layout: Scale So Small Screen is 1:1px"
msgstr "Гибридная компоновка: Масштабировать так, чтобы малый экран был 1:1 пикселей"

msgctxt "#30029"
msgid "Hybrid Layout: Show Both Screens"
msgstr "Гибридная компоновка: Показывать оба экрана"

msgctxt "#30030"
msgid "Hybrid Layout: Cursor Always on Small Screen"
msgstr "Гибридная компоновка: Курсор всегда на малом экране"

msgctxt "#30031"
msgid "Mouse/Pointer"
msgstr "Мышь/указатель"

msgctxt "#30032"
msgid "Pointer Type"
msgstr "Тип указателя"

msgctxt "#30033"
msgid "Mouse Speed"
msgstr "Скорость мыши"

msgctxt "#30034"
msgid "Pointer Rotation"
msgstr "Поворот указателя"

msgctxt "#30035"
msgid "Pointer Mode for Left Analog"
msgstr "Режим указателя для левого аналога"

msgctxt "#30036"
msgid "Pointer Mode for Right Analog"
msgstr "Режим указателя для правого аналога"

msgctxt "#30037"
msgid "Emulated Pointer Deadzone Percent"
msgstr "Процент мёртвой зоны эмулируемого указателя"

msgctxt "#30038"
msgid "Emulated Pointer Acceleration Modifier Percent"
msgstr "Процент модификатора ускорения эмулируемого указателя"

msgctxt "#30039"
msgid "Emulated Stylus Pressure Modifier Percent"
msgstr "Процент модификатора давления эмулируемого стилуса"

msgctxt "#30040"
msgid "Pointer Colour"
msgstr "Цвет указателя"

msgctxt "#30041"
msgid "Microphone Button Noise Type"
msgstr "Тип шума кнопки микрофона"

msgctxt "#30042"
msgid "Sets what type of noise to use when pressing the microfone button."
msgstr "Задаёт тип шума, используемый при нажатии кнопки микрофона."

msgctxt "#30043"
msgid "Pattern"
msgstr "Шаблон"

msgctxt "#30044"
msgid "Random"
msgstr "Случайный"

msgctxt "#30045"
msgid "System"
msgstr "Система"

msgctxt "#30046"
msgid "Configure system options."
msgstr "Настройка системных параметров."

msgctxt "#30047"
msgid "Set language to use for firmware."
msgstr "Задаёт язык для прошивки."

msgctxt "#30048"
msgid "Use official BIOS. Core needs to be restarted for changes to apply."
msgstr "Использовать официальный BIOS. Для применения изменений требуется перезапуск ядра."

msgctxt "#30049"
msgid "Boot directly into the BIOS."
msgstr "Загружаться сразу в BIOS."

msgctxt "#30050"
msgid "Load the game into memory to reduce IO lag."
msgstr "Подгружать игру в память для снижения задержек ввода-вывода."

msgctxt "#30051"
msgid "Set the amount of CPU cores to use."
msgstr "Задаёт количество используемых ядер ЦП."

msgctxt "#30052"
msgid "Enable or disable the use of the dynamic recompiler."
msgstr "Включает или отключает использование динамического рекомпилятора."

msgctxt "#30053"
msgid "Set the block size of the JIT dynamic recompiler."
msgstr "Задаёт размер блока динамического рекомпилятора JIT."

msgctxt "#30054"
msgid "Enables the use of Advanced Bus-Level Timing."
msgstr "Включает использование расширенной синхронизации на уровне шины."

msgctxt "#30055"
msgid "Graphics"
msgstr "Графика"

msgctxt "#30056"
msgid "Configure graphics options."
msgstr "Настройка параметров графики."

msgctxt "#30057"
msgid "Sets the amount of frames to skip."
msgstr "Задаёт количество пропускаемых кадров."

msgctxt "#30058"
msgid "Sets the internal resolution. Higher resolutions can provide better clarity for 3D scenes & objects, but will increase the performance requirements"
msgstr "Задаёт внутреннее разрешение. Более высокие разрешения обеспечивают лучшую чёткость трёхмерных сцен и объектов, но повышают требования к производительности."

msgctxt "#30059"
msgid "1x (256x192)"
msgstr "1x (256x192)"

msgctxt "#30060"
msgid "2x (512x384)"
msgstr "2x (512x384)"

msgctxt "#30061"
msgid "3x (768x576)"
msgstr "3x (768x576)"

msgctxt "#30062"
msgid "4x (1024x768)"
msgstr "4x (1024x768)"

msgctxt "#30063"
msgid "5x (1280x960)"
msgstr "5x (1280x960)"

msgctxt "#30064"
msgid "6x (1536x1152)"
msgstr "6x (1536x1152)"

msgctxt "#30065"
msgid "7x (1792x1344)"
msgstr "7x (1792x1344)"

msgctxt "#30066"
msgid "8x (2048x1536)"
msgstr "8x (2048x1536)"

msgctxt "#30067"
msgid "9x (2304x1728)"
msgstr "9x (2304x1728)"

msgctxt "#30068"
msgid "10x (2560x1920)"
msgstr "10x (2560x1920)"

msgctxt "#30069"
msgid "Enable the OpenGL Rasterizer for 3D."
msgstr "Включает растеризатор OpenGL для трёхмерной графики."

msgctxt "#30070"
msgid "Sets the Color Depth to either 16-bit or 32-bit colors. Requires the OpenGL Rasterizer."
msgstr "Задаёт глубину цвета: 16 или 32 бита. Требует растеризатор OpenGL."

msgctxt "#30071"
msgid "Set the multiplier for Multisampling Anti Aliasing. Requires the OpenGL Rasterizer."
msgstr "Задаёт множитель для мультисэмплингового сглаживания. Требует растеризатор OpenGL."

msgctxt "#30072"
msgid "Enables Texture Smoothing. Requires the OpenGL Rasterizer."
msgstr "Включает сглаживание текстур. Требует растеризатор OpenGL."

msgctxt "#30073"
msgid "Enables Shadow Polygons. Requires the OpenGL Rasterizer."
msgstr "Включает полигоны теней. Требует растеризатор OpenGL."

msgctxt "#30074"
msgid "Enables Special 0 Alpha. Requires the OpenGL Rasterizer."
msgstr "Включает специальную альфу 0. Требует растеризатор OpenGL."

msgctxt "#30075"
msgid "Enables NDS Depth Calculation. Requires the OpenGL Rasterizer."
msgstr "Включает вычисление глубины NDS. Требует растеризатор OpenGL."

msgctxt "#30076"
msgid "Enables Depth-LEqual Polygon Facing. Requires the OpenGL Rasterizer."
msgstr "Включает ориентацию полигонов Depth-LEqual. Требует растеризатор OpenGL."

msgctxt "#30077"
msgid "Enables High-res Color Interpolation."
msgstr "Включает цветовую интерполяцию высокого разрешения."

msgctxt "#30078"
msgid "Enables Line Hack."
msgstr "Включает исправление линий (Line Hack)."

msgctxt "#30079"
msgid "Enables Texture Hack."
msgstr "Включает исправление текстур (Texture Hack)."

msgctxt "#30080"
msgid "Enables Edge Marking."
msgstr "Включает маркировку краёв."

msgctxt "#30081"
msgid "Sets the multiplier for xBrz texture scaling to use."
msgstr "Задаёт множитель масштабирования текстур xBrz."

msgctxt "#30082"
msgid "Enables Texture Deposterization."
msgstr "Включает депостеризацию текстур."

msgctxt "#30083"
msgid "Screen"
msgstr "Экран"

msgctxt "#30084"
msgid "Configure screen options."
msgstr "Настройка параметров экрана."

msgctxt "#30085"
msgid "Select the screen layout to use."
msgstr "Выберите используемый макет экрана."

msgctxt "#30086"
msgid "Top/Bottom"
msgstr "Сверху/снизу"

msgctxt "#30087"
msgid "Bottom/Top"
msgstr "Снизу/сверху"

msgctxt "#30088"
msgid "Left/Right"
msgstr "Слева/справа"

msgctxt "#30089"
msgid "Right/Left"
msgstr "Справа/слева"

msgctxt "#30090"
msgid "Top only"
msgstr "Только верхний"

msgctxt "#30091"
msgid "Bottom only"
msgstr "Только нижний"

msgctxt "#30092"
msgid "Hybrid/Top"
msgstr "Гибрид/верхний"

msgctxt "#30093"
msgid "Hybrid/Bottom"
msgstr "Гибрид/нижний"

msgctxt "#30094"
msgid "Sets the amout of space between the top and bottom screens."
msgstr "Задаёт расстояние между верхним и нижним экранами."

msgctxt "#30095"
msgid "Sets the screen ratio for the hybrid screen(s) to use."
msgstr "Задаёт соотношение сторон для гибридного экрана (экранов)."

msgctxt "#30096"
msgid "Force the small screen to render at 1:1px."
msgstr "Принудительно отображать малый экран в масштабе 1:1 пиксель."

msgctxt "#30097"
msgid "Show both top & bottom small screens."
msgstr "Показывать оба малых экрана: верхний и нижний."

msgctxt "#30098"
msgid "Only display the cursor on the small bottom screen."
msgstr "Отображать курсор только на малом нижнем экране."

msgctxt "#30099"
msgid "Input"
msgstr "Ввод"

msgctxt "#30100"
msgid "Configure input options."
msgstr "Настройка параметров ввода."

msgctxt "#30101"
msgid "Enables the NDS pointer."
msgstr "Включает указатель NDS."

msgctxt "#30102"
msgid "Select what type of input to use for the pointer."
msgstr "Выберите тип ввода для указателя."

msgctxt "#30103"
msgid "Mouse"
msgstr "Мышь"

msgctxt "#30104"
msgid "Touchscreen"
msgstr "Сенсорный экран"

msgctxt "#30105"
msgid "Sets the speed multiplier to use for the mouse pointer."
msgstr "Задаёт множитель скорости для указателя мыши."

msgctxt "#30106"
msgid "Sets the rotation of the pointer."
msgstr "Задаёт поворот указателя."

msgctxt "#30107"
msgid "Sets the pointer mode for the left analog stick."
msgstr "Задаёт режим указателя для левого аналогового стика."

msgctxt "#30108"
msgid "None"
msgstr "Нет"

msgctxt "#30109"
msgid "Emulated"
msgstr "Эмулируемый"

msgctxt "#30110"
msgid "Absolute"
msgstr "Абсолютный"

msgctxt "#30111"
msgid "Pressed"
msgstr "Нажатие"

msgctxt "#30112"
msgid "Sets the pointer mode for the right analog stick."
msgstr "Задаёт режим указателя для правого аналогового стика."

msgctxt "#30113"
msgid "Sets the stick deadzone for the emulated pointer."
msgstr "Задаёт мёртвую зону стика для эмулируемого указателя."

msgctxt "#30114"
msgid "Sets the percent for the Pointer Acceleration Modifier."
msgstr "Задаёт процент модификатора ускорения указателя."

msgctxt "#30115"
msgid "Sets the percent for the Emulated Stylus Pressure Modifier."
msgstr "Задаёт процент модификатора давления эмулируемого стилуса."

msgctxt "#30116"
msgid "Sets what color to use for the pointer."
msgstr "Задаёт цвет указателя."

