msgctxt "Addon Summary"
msgid "Nintendo - DS (DeSmuME)"
msgstr "Nintendo - DS (DeSmuME)"

msgctxt "Addon Description"
msgid "DeSmuME is software that allows you to emulate a Nintendo DS system."
msgstr "DeSmuME je software, který umožňuje emulovat systém Nintendo DS."

msgctxt "Addon Disclaimer"
msgid "Special thanks to yopyop (original author of DeSmuME) and Martin Korth (author of GBATEK)"
msgstr "Zvláštní poděkování: yopyop (původní autor DeSmuME) a Martin Korth (autor GBATEK)"

msgctxt "#30001"
msgid "Firmware Language"
msgstr "Jazyk firmwaru"

msgctxt "#30002"
msgid "Use External BIOS/Firmware (restart)"
msgstr "Používat externí BIOS/firmware (vyžaduje restart)"

msgctxt "#30003"
msgid "Boot Into BIOS (interpreter and external bios only)"
msgstr "Spouštět do BIOSu (pouze interpreter a externí BIOS)"

msgctxt "#30004"
msgid "Load Game Into Memory (restart)"
msgstr "Načíst hru do paměti (vyžaduje restart)"

msgctxt "#30005"
msgid "CPU Cores"
msgstr "Jádra CPU"

msgctxt "#30006"
msgid "CPU Mode (restart)"
msgstr "Režim CPU (vyžaduje restart)"

msgctxt "#30007"
msgid "JIT Block Size"
msgstr "Velikost bloku JIT"

msgctxt "#30008"
msgid "Enable Advanced Bus-Level Timing"
msgstr "Povolit pokročilé časování na úrovni sběrnice"

msgctxt "#30009"
msgid "Frameskip"
msgstr "Přeskakování snímků"

msgctxt "#30010"
msgid "Internal Resolution"
msgstr "Interní rozlišení"

msgctxt "#30011"
msgid "OpenGL Rasterizer (restart)"
msgstr "Rasterizér OpenGL (vyžaduje restart)"

msgctxt "#30012"
msgid "OpenGL: Color Depth (restart)"
msgstr "OpenGL: barevná hloubka (vyžaduje restart)"

msgctxt "#30013"
msgid "OpenGL: Multisampling AA"
msgstr "OpenGL: multisamplingové vyhlazování (AA)"

msgctxt "#30014"
msgid "OpenGL: Texture Smoothing"
msgstr "OpenGL: vyhlazování textur"

msgctxt "#30015"
msgid "OpenGL: Shadow Polygons"
msgstr "OpenGL: stínové polygony"

msgctxt "#30016"
msgid "OpenGL: Special 0 Alpha"
msgstr "OpenGL: speciální alfa 0"

msgctxt "#30017"
msgid "OpenGL: NDS Depth Calculation"
msgstr "OpenGL: výpočet hloubky NDS"

msgctxt "#30018"
msgid "OpenGL: Depth-LEqual Polygon Facing"
msgstr "OpenGL: orientace polygonů při Depth-LEqual"

msgctxt "#30019"
msgid "Soft3D: High-res Color Interpolation"
msgstr "Soft3D: interpolace barev ve vysokém rozlišení"

msgctxt "#30020"
msgid "Soft3D: Line Hack"
msgstr "Soft3D: úprava čar"

msgctxt "#30021"
msgid "Soft3D: Texture Hack"
msgstr "Soft3D: úprava textur"

msgctxt "#30022"
msgid "Edge Marking"
msgstr "Zvýraznění hran"

msgctxt "#30023"
msgid "Texture Scaling (xBrz)"
msgstr "Škálování textur (xBrz)"

msgctxt "#30024"
msgid "Texture Deposterization"
msgstr "Odstranění posterizace textur"

msgctxt "#30025"
msgid "Screen Layout"
msgstr "Rozložení obrazovek"

msgctxt "#30026"
msgid "Screen Gap"
msgstr "Mezera mezi obrazovkami"

msgctxt "#30027"
msgid "Hybrid Layout: Ratio"
msgstr "Hybridní rozložení: poměr"

msgctxt "#30028"
msgid "Hybrid Layout: Scale So Small Screen is 1:1px"
msgstr "Hybridní rozložení: škálovat tak, aby malá obrazovka byla 1:1 px"

msgctxt "#30029"
msgid "Hybrid Layout: Show Both Screens"
msgstr "Hybridní rozložení: zobrazit obě obrazovky"

msgctxt "#30030"
msgid "Hybrid Layout: Cursor Always on Small Screen"
msgstr "Hybridní rozložení: ukazatel vždy na malé obrazovce"

msgctxt "#30031"
msgid "Mouse/Pointer"
msgstr "Myš/ukazatel"

msgctxt "#30032"
msgid "Pointer Type"
msgstr "Typ ukazatele"

msgctxt "#30033"
msgid "Mouse Speed"
msgstr "Rychlost myši"

msgctxt "#30034"
msgid "Pointer Rotation"
msgstr "Otočení ukazatele"

msgctxt "#30035"
msgid "Pointer Mode for Left Analog"
msgstr "Režim ukazatele pro levou analogovou páčku"

msgctxt "#30036"
msgid "Pointer Mode for Right Analog"
msgstr "Režim ukazatele pro pravou analogovou páčku"

msgctxt "#30037"
msgid "Emulated Pointer Deadzone Percent"
msgstr "Mrtvá zóna emulovaného ukazatele (%)"

msgctxt "#30038"
msgid "Emulated Pointer Acceleration Modifier Percent"
msgstr "Modifikátor zrychlení emulovaného ukazatele (%)"

msgctxt "#30039"
msgid "Emulated Stylus Pressure Modifier Percent"
msgstr "Modifikátor tlaku emulovaného stylusu (%)"

msgctxt "#30040"
msgid "Pointer Colour"
msgstr "Barva ukazatele"

msgctxt "#30041"
msgid "Microphone Button Noise Type"
msgstr "Typ šumu pro tlačítko mikrofonu"

msgctxt "#30042"
msgid "Sets what type of noise to use when pressing the microfone button."
msgstr "Nastavuje typ šumu, který se použije při stisknutí tlačítka mikrofonu."

msgctxt "#30043"
msgid "Pattern"
msgstr "Vzorek"

msgctxt "#30044"
msgid "Random"
msgstr "Náhodný šum"

msgctxt "#30045"
msgid "System"
msgstr "Systém"

msgctxt "#30046"
msgid "Configure system options."
msgstr "Konfigurovat nastavení systému."

msgctxt "#30047"
msgid "Set language to use for firmware."
msgstr "Nastavit jazyk firmwaru."

msgctxt "#30048"
msgid "Use official BIOS. Core needs to be restarted for changes to apply."
msgstr "Použít oficiální BIOS. Aby se změny projevily, je nutné restartovat jádro."

msgctxt "#30049"
msgid "Boot directly into the BIOS."
msgstr "Spustit přímo do BIOSu."

msgctxt "#30050"
msgid "Load the game into memory to reduce IO lag."
msgstr "Načíst hru do paměti a snížit tak zpoždění vstupu/výstupu."

msgctxt "#30051"
msgid "Set the amount of CPU cores to use."
msgstr "Nastavit počet jader CPU, která se mají použít."

msgctxt "#30052"
msgid "Enable or disable the use of the dynamic recompiler."
msgstr "Povolit nebo zakázat použití dynamického rekompilátoru."

msgctxt "#30053"
msgid "Set the block size of the JIT dynamic recompiler."
msgstr "Nastavit velikost bloku dynamického rekompilátoru JIT."

msgctxt "#30054"
msgid "Enables the use of Advanced Bus-Level Timing."
msgstr "Povolit použití pokročilého časování na úrovni sběrnice."

msgctxt "#30055"
msgid "Graphics"
msgstr "Grafika"

msgctxt "#30056"
msgid "Configure graphics options."
msgstr "Konfigurovat nastavení grafiky."

msgctxt "#30057"
msgid "Sets the amount of frames to skip."
msgstr "Nastavit počet snímků, které se mají přeskočit."

msgctxt "#30058"
msgid "Sets the internal resolution. Higher resolutions can provide better clarity for 3D scenes & objects, but will increase the performance requirements"
msgstr "Nastavuje interní rozlišení. Vyšší rozlišení mohou zajistit lepší ostrost 3D scén a objektů, ale zvýší nároky na výkon."

msgctxt "#30059"
msgid "1x (256x192)"
msgstr "1x (256x192)"

msgctxt "#30060"
msgid "2x (512x384)"
msgstr "2x (512x384)"

msgctxt "#30061"
msgid "3x (768x576)"
msgstr "3x (768x576)"

msgctxt "#30062"
msgid "4x (1024x768)"
msgstr "4x (1024x768)"

msgctxt "#30063"
msgid "5x (1280x960)"
msgstr "5x (1280x960)"

msgctxt "#30064"
msgid "6x (1536x1152)"
msgstr "6x (1536x1152)"

msgctxt "#30065"
msgid "7x (1792x1344)"
msgstr "7x (1792x1344)"

msgctxt "#30066"
msgid "8x (2048x1536)"
msgstr "8x (2048x1536)"

msgctxt "#30067"
msgid "9x (2304x1728)"
msgstr "9x (2304x1728)"

msgctxt "#30068"
msgid "10x (2560x1920)"
msgstr "10x (2560x1920)"

msgctxt "#30069"
msgid "Enable the OpenGL Rasterizer for 3D."
msgstr "Povolit rasterizér OpenGL pro 3D."

msgctxt "#30070"
msgid "Sets the Color Depth to either 16-bit or 32-bit colors. Requires the OpenGL Rasterizer."
msgstr "Nastavuje barevnou hloubku na 16 bitů nebo 32 bitů. Vyžaduje rasterizér OpenGL."

msgctxt "#30071"
msgid "Set the multiplier for Multisampling Anti Aliasing. Requires the OpenGL Rasterizer."
msgstr "Nastavit násobitel multisamplingového vyhlazování. Vyžaduje rasterizér OpenGL."

msgctxt "#30072"
msgid "Enables Texture Smoothing. Requires the OpenGL Rasterizer."
msgstr "Povolit vyhlazování textur. Vyžaduje rasterizér OpenGL."

msgctxt "#30073"
msgid "Enables Shadow Polygons. Requires the OpenGL Rasterizer."
msgstr "Povolit stínové polygony. Vyžaduje rasterizér OpenGL."

msgctxt "#30074"
msgid "Enables Special 0 Alpha. Requires the OpenGL Rasterizer."
msgstr "Povoluje speciální alfu 0. Vyžaduje rasterizér OpenGL."

msgctxt "#30075"
msgid "Enables NDS Depth Calculation. Requires the OpenGL Rasterizer."
msgstr "Povolit výpočet hloubky NDS. Vyžaduje rasterizér OpenGL."

msgctxt "#30076"
msgid "Enables Depth-LEqual Polygon Facing. Requires the OpenGL Rasterizer."
msgstr "Povolit orientaci polygonů při Depth-LEqual. Vyžaduje rasterizér OpenGL."

msgctxt "#30077"
msgid "Enables High-res Color Interpolation."
msgstr "Povolit interpolaci barev ve vysokém rozlišení."

msgctxt "#30078"
msgid "Enables Line Hack."
msgstr "Povolit úpravu čar."

msgctxt "#30079"
msgid "Enables Texture Hack."
msgstr "Povolit úpravu textur."

msgctxt "#30080"
msgid "Enables Edge Marking."
msgstr "Povolit zvýraznění hran."

msgctxt "#30081"
msgid "Sets the multiplier for xBrz texture scaling to use."
msgstr "Nastavit násobitel škálování textur pomocí xBrz."

msgctxt "#30082"
msgid "Enables Texture Deposterization."
msgstr "Povolit odstranění posterizace textur."

msgctxt "#30083"
msgid "Screen"
msgstr "Obrazovka"

msgctxt "#30084"
msgid "Configure screen options."
msgstr "Konfigurovat nastavení obrazovky."

msgctxt "#30085"
msgid "Select the screen layout to use."
msgstr "Vybrat rozložení obrazovek, které se má použít."

msgctxt "#30086"
msgid "Top/Bottom"
msgstr "Nahoře/dole"

msgctxt "#30087"
msgid "Bottom/Top"
msgstr "Dole/nahoře"

msgctxt "#30088"
msgid "Left/Right"
msgstr "Vlevo/vpravo"

msgctxt "#30089"
msgid "Right/Left"
msgstr "Vpravo/vlevo"

msgctxt "#30090"
msgid "Top only"
msgstr "Pouze nahoře"

msgctxt "#30091"
msgid "Bottom only"
msgstr "Pouze dole"

msgctxt "#30092"
msgid "Hybrid/Top"
msgstr "Hybridní/nahoře"

msgctxt "#30093"
msgid "Hybrid/Bottom"
msgstr "Hybridní/dole"

msgctxt "#30094"
msgid "Sets the amout of space between the top and bottom screens."
msgstr "Nastavuje velikost mezery mezi horní a dolní obrazovkou."

msgctxt "#30095"
msgid "Sets the screen ratio for the hybrid screen(s) to use."
msgstr "Nastavuje poměr obrazovek používaný v hybridním režimu."

msgctxt "#30096"
msgid "Force the small screen to render at 1:1px."
msgstr "Vynutit vykreslování malé obrazovky v měřítku 1:1px."

msgctxt "#30097"
msgid "Show both top & bottom small screens."
msgstr "Zobrazit obě malé obrazovky – horní i dolní."

msgctxt "#30098"
msgid "Only display the cursor on the small bottom screen."
msgstr "Zobrazuje ukazatel pouze na malé dolní obrazovce."

msgctxt "#30099"
msgid "Input"
msgstr "Vstup"

msgctxt "#30100"
msgid "Configure input options."
msgstr "Konfigurovat nastavení vstupu."

msgctxt "#30101"
msgid "Enables the NDS pointer."
msgstr "Povolit ukazatel NDS."

msgctxt "#30102"
msgid "Select what type of input to use for the pointer."
msgstr "Vybrat typ vstupu, který se má použít pro ukazatel."

msgctxt "#30103"
msgid "Mouse"
msgstr "Myš"

msgctxt "#30104"
msgid "Touchscreen"
msgstr "Dotyková obrazovka"

msgctxt "#30105"
msgid "Sets the speed multiplier to use for the mouse pointer."
msgstr "Nastavuje násobitel rychlosti ukazatele myši."

msgctxt "#30106"
msgid "Sets the rotation of the pointer."
msgstr "Nastavuje otočení ukazatele."

msgctxt "#30107"
msgid "Sets the pointer mode for the left analog stick."
msgstr "Nastavuje režim ukazatele pro levou analogovou páčku."

msgctxt "#30108"
msgid "None"
msgstr "Žádné"

msgctxt "#30109"
msgid "Emulated"
msgstr "Emulovaný"

msgctxt "#30110"
msgid "Absolute"
msgstr "Absolutní"

msgctxt "#30111"
msgid "Pressed"
msgstr "Stisk"

msgctxt "#30112"
msgid "Sets the pointer mode for the right analog stick."
msgstr "Nastavuje režim ukazatele pro pravou analogovou páčku."

msgctxt "#30113"
msgid "Sets the stick deadzone for the emulated pointer."
msgstr "Nastavuje mrtvou zónu páčky pro emulovaný ukazatel."

msgctxt "#30114"
msgid "Sets the percent for the Pointer Acceleration Modifier."
msgstr "Nastavuje procentní hodnotu modifikátoru zrychlení ukazatele."

msgctxt "#30115"
msgid "Sets the percent for the Emulated Stylus Pressure Modifier."
msgstr "Nastavuje procentní hodnotu modifikátoru tlaku emulovaného stylusu."

msgctxt "#30116"
msgid "Sets what color to use for the pointer."
msgstr "Nastavuje barvu používanou pro ukazatel."

msgctxt "#30117"
msgid "White"
msgstr "Bílá"

msgctxt "#30118"
msgid "Black"
msgstr "Černá"

msgctxt "#30119"
msgid "Red"
msgstr "Červená"

msgctxt "#30120"
msgid "Blue"
msgstr "Modrá"

msgctxt "#30121"
msgid "Yellow"
msgstr "Žlutá"
