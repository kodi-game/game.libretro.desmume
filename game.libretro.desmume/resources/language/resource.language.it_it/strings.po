msgctxt "Addon Summary"
msgid "Nintendo - DS (DeSmuME)"
msgstr "Nintendo - DS (DeSmuME)"

msgctxt "Addon Description"
msgid "DeSmuME is software that allows you to emulate a Nintendo DS system."
msgstr "DeSmuME è un software che consente di emulare un sistema Nintendo DS."

msgctxt "Addon Disclaimer"
msgid "Special thanks to yopyop (original author of DeSmuME) and Martin Korth (author of GBATEK)"
msgstr "Ringraziamenti speciali a yopyop (autore originale di DeSmuME) e Martin Korth (autore di GBATEK)"

msgctxt "#30001"
msgid "Firmware Language"
msgstr "Lingua del firmware"

msgctxt "#30002"
msgid "Use External BIOS/Firmware (restart)"
msgstr "Usa BIOS/firmware esterno (richiede riavvio)"

